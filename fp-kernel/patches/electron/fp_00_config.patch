From a910f4a81338e5f69b84c5b5d6eb30e6425aa95c Mon Sep 17 00:00:00 2001
From: fp <fp@local>
Date: Sat, 26 Sep 2026 18:34:57 -0400
Subject: [PATCH] fp_00: config delivery chain (setFingerprintConfig + renderer
 cmdline + fpkernel version)

---
 filenames.gni                             |  1 +
 shell/browser/api/electron_api_session.cc |  9 +++++++++
 shell/browser/api/electron_api_session.h  |  1 +
 shell/browser/electron_browser_client.cc  | 13 +++++++++++++
 shell/browser/electron_browser_context.cc |  5 +++++
 shell/browser/electron_browser_context.h  |  5 +++++
 shell/browser/fingerprint/fp_kernel.h     | 22 ++++++++++++++++++++++
 shell/common/node_bindings.cc             |  2 ++
 8 files changed, 58 insertions(+)
 create mode 100644 shell/browser/fingerprint/fp_kernel.h

diff --git a/filenames.gni b/filenames.gni
index a237bef17..e85af397f 100644
--- a/filenames.gni
+++ b/filenames.gni
@@ -393,6 +393,7 @@ filenames = {
     "shell/browser/electron_browser_context.h",
     "shell/browser/electron_browser_main_parts.cc",
     "shell/browser/electron_browser_main_parts.h",
+    "shell/browser/fingerprint/fp_kernel.h",  # FP-HOOK
     "shell/browser/electron_crypto_module_delegate_nss.cc",
     "shell/browser/electron_crypto_module_delegate_nss.h",
     "shell/browser/electron_download_manager_delegate.cc",
diff --git a/shell/browser/api/electron_api_session.cc b/shell/browser/api/electron_api_session.cc
index 84ad35073..b72f69992 100644
--- a/shell/browser/api/electron_api_session.cc
+++ b/shell/browser/api/electron_api_session.cc
@@ -12,6 +12,7 @@
 #include <vector>
 
 #include "base/command_line.h"
+#include "base/base64.h"  // FP-HOOK
 #include "base/containers/fixed_flat_map.h"
 #include "base/containers/map_util.h"
 #include "base/files/file_enumerator.h"
@@ -1038,6 +1039,13 @@ std::string Session::GetUserAgent() {
   return browser_context_->GetUserAgent();
 }
 
+// FP-HOOK begin：按 Session 绑定指纹配置，存入该分区的 BrowserContext；
+// ElectronBrowserClient::AppendExtraCommandLineSwitches 负责下发到渲染进程。
+void Session::SetFingerprintConfig(const std::string& config_json) {
+  browser_context_->SetFingerprintConfig(base::Base64Encode(config_json));
+}
+// FP-HOOK end
+
 void Session::SetSSLConfig(network::mojom::SSLConfigPtr config) {
   browser_context_->SetSSLConfig(std::move(config));
 }
@@ -1824,6 +1832,7 @@ void Session::FillObjectTemplate(v8::Isolate* isolate,
                  &Session::AllowNTLMCredentialsForDomains)
       .SetMethod("isPersistent", &Session::IsPersistent)
       .SetMethod("setUserAgent", &Session::SetUserAgent)
+      .SetMethod("setFingerprintConfig", &Session::SetFingerprintConfig)  // FP-HOOK
       .SetMethod("getUserAgent", &Session::GetUserAgent)
       .SetMethod("setSSLConfig", &Session::SetSSLConfig)
       .SetMethod("getBlobData", &Session::GetBlobData)
diff --git a/shell/browser/api/electron_api_session.h b/shell/browser/api/electron_api_session.h
index 8bd107199..407086ace 100644
--- a/shell/browser/api/electron_api_session.h
+++ b/shell/browser/api/electron_api_session.h
@@ -141,6 +141,7 @@ class Session final : public gin::Wrappable<Session>,
   void AllowNTLMCredentialsForDomains(const std::string& domains);
   void SetUserAgent(const std::string& user_agent, gin::Arguments* args);
   std::string GetUserAgent();
+  void SetFingerprintConfig(const std::string& config_json);  // FP-HOOK
   void SetSSLConfig(network::mojom::SSLConfigPtr config);
   bool IsPersistent();
   v8::Local<v8::Promise> GetBlobData(v8::Isolate* isolate,
diff --git a/shell/browser/electron_browser_client.cc b/shell/browser/electron_browser_client.cc
index 79e415054..bca8b5ad0 100644
--- a/shell/browser/electron_browser_client.cc
+++ b/shell/browser/electron_browser_client.cc
@@ -95,6 +95,7 @@
 #include "shell/browser/electron_autofill_driver_factory.h"
 #include "shell/browser/electron_browser_context.h"
 #include "shell/browser/electron_browser_main_parts.h"
+#include "shell/browser/fingerprint/fp_kernel.h"  // FP-HOOK
 #include "shell/browser/electron_child_process_host_flags.h"
 #include "shell/browser/electron_navigation_throttle.h"
 #include "shell/browser/electron_plugin_info_host_impl.h"
@@ -691,6 +692,18 @@ void ElectronBrowserClient::AppendExtraCommandLineSwitches(
       command_line->AppendSwitch(switches::kEnableSandbox);
     }
 
+    // FP-HOOK begin：把所属分区的指纹配置下发给该渲染进程（覆盖跨站
+    // iframe 的独立渲染进程；Service Worker 不经此路径，另由 fp_10 处理）。
+    if (render_process_host && !render_process_host->IsSpare()) {
+      auto* fp_ctx = static_cast<ElectronBrowserContext*>(
+          render_process_host->GetBrowserContext());
+      if (fp_ctx && !fp_ctx->fingerprint_config().empty()) {
+        command_line->AppendSwitchASCII(fp::kConfigSwitch,
+                                        fp_ctx->fingerprint_config());
+      }
+    }
+    // FP-HOOK end
+
     renderer_process_sandboxed_[unsafe_process_id] =
         !command_line->HasSwitch(sandbox::policy::switches::kNoSandbox);
   }
diff --git a/shell/browser/electron_browser_context.cc b/shell/browser/electron_browser_context.cc
index 68bf5f0f7..afe453c0e 100644
--- a/shell/browser/electron_browser_context.cc
+++ b/shell/browser/electron_browser_context.cc
@@ -526,6 +526,11 @@ void ElectronBrowserContext::SetUserAgent(const std::string& user_agent) {
   user_agent_ = user_agent;
 }
 
+void ElectronBrowserContext::SetFingerprintConfig(  // FP-HOOK
+    std::string config_base64) {                    // FP-HOOK
+  fingerprint_config_ = std::move(config_base64);   // FP-HOOK
+}                                                   // FP-HOOK
+
 base::FilePath ElectronBrowserContext::GetPath() const {
   return path_;
 }
diff --git a/shell/browser/electron_browser_context.h b/shell/browser/electron_browser_context.h
index 494072011..537d4ad6a 100644
--- a/shell/browser/electron_browser_context.h
+++ b/shell/browser/electron_browser_context.h
@@ -91,6 +91,10 @@ class ElectronBrowserContext : public content::BrowserContext {
 
   void SetUserAgent(const std::string& user_agent);
   std::string GetUserAgent() const;
+  void SetFingerprintConfig(std::string config_base64);  // FP-HOOK
+  const std::string& fingerprint_config() const {        // FP-HOOK
+    return fingerprint_config_;                          // FP-HOOK
+  }                                                      // FP-HOOK
   bool can_use_http_cache() const { return use_cache_; }
   int max_cache_size() const { return max_cache_size_; }
   ResolveProxyHelper* GetResolveProxyHelper();
@@ -222,6 +226,7 @@ class ElectronBrowserContext : public content::BrowserContext {
   std::unique_ptr<ProtocolRegistry> protocol_registry_;
 
   std::optional<std::string> user_agent_;
+  std::string fingerprint_config_;  // FP-HOOK
   base::FilePath path_;
   bool in_memory_ = false;
   bool use_cache_ = true;
diff --git a/shell/browser/fingerprint/fp_kernel.h b/shell/browser/fingerprint/fp_kernel.h
new file mode 100644
index 000000000..9c46e5418
--- /dev/null
+++ b/shell/browser/fingerprint/fp_kernel.h
@@ -0,0 +1,22 @@
+// Copyright 2026 The fp-kernel Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef SHELL_BROWSER_FINGERPRINT_FP_KERNEL_H_
+#define SHELL_BROWSER_FINGERPRINT_FP_KERNEL_H_
+
+namespace fp {
+
+// Self-reported kernel version, exposed to the app as
+// process.versions.fpkernel. The app refuses to log in accounts when this
+// is absent or outside its compatible range. Bump on every kernel change.
+inline constexpr char kVersion[] = "0.1.0";
+
+// Command line switch carrying the per-session fingerprint config
+// (base64-encoded JSON) to renderer processes. The Blink-side reader in
+// third_party/blink/renderer/platform/fingerprint/ uses the same name.
+inline constexpr char kConfigSwitch[] = "fp-config";
+
+}  // namespace fp
+
+#endif  // SHELL_BROWSER_FINGERPRINT_FP_KERNEL_H_
diff --git a/shell/common/node_bindings.cc b/shell/common/node_bindings.cc
index efcc5a30e..b9ee44c6f 100644
--- a/shell/common/node_bindings.cc
+++ b/shell/common/node_bindings.cc
@@ -37,6 +37,7 @@
 #include "shell/common/electron_command_line.h"
 #include "shell/common/gin_converters/callback_converter.h"
 #include "shell/common/gin_converters/file_path_converter.h"
+#include "shell/browser/fingerprint/fp_kernel.h"  // FP-HOOK
 #include "shell/common/gin_helper/dictionary.h"
 #include "shell/common/gin_helper/event.h"
 #include "shell/common/gin_helper/event_emitter_caller.h"
@@ -1236,6 +1237,7 @@ void OnNodePreload(node::Environment* env,
   if (dict.Get("versions", &versions)) {
     versions.SetReadOnly(ELECTRON_PROJECT_NAME, ELECTRON_VERSION_STRING);
     versions.SetReadOnly("chrome", CHROME_VERSION_STRING);
+    versions.SetReadOnly("fpkernel", fp::kVersion);  // FP-HOOK
 #if BUILDFLAG(HAS_VENDOR_VERSION)
     versions.SetReadOnly(BUILDFLAG(VENDOR_VERSION_NAME),
                          BUILDFLAG(VENDOR_VERSION_VALUE));
-- 
2.55.0.windows.5

