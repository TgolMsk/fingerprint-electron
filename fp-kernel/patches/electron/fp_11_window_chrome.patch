+#ifndef SHELL_RENDERER_CHROME_OBJECT_BINDINGS_H_
+#define SHELL_RENDERER_CHROME_OBJECT_BINDINGS_H_
+
+#include "v8/include/v8-forward.h"
+
+namespace electron {
+
+// 在每个 JS context 上安装与真 Chrome 一致的 window.chrome 对象
+// （loadTimes / csi / app），全部 v8 原生函数。照抄
+// chrome/renderer/loadtimes_bindings.cc（M152）的行为，不依赖 fp-config——
+// 真 Chrome 对所有网页都提供该对象。
+void InstallChromeObjectBindings(v8::Local<v8::Context> context);
+
+}  // namespace electron
+
+#endif  // SHELL_RENDERER_CHROME_OBJECT_BINDINGS_H_
