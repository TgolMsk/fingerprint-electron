       }
       SynthesizeGLError(
           GL_INVALID_ENUM, "getParameter",
@@ -5356,6 +5361,13 @@ void WebGLRenderingContextBase::ReadPixelsHelper(GLint x,
       return;
     }
     ContextGL()->ReadPixels(x, y, width, height, format, type, data);
+    // FP-HOOK：readPixels 读回路径确定性噪声（仅 RGBA/UNSIGNED_BYTE，
