From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fp <fp@local>
Date: Sat, 26 Sep 2026 21:50:10 -0400
Subject: fp_20: navigator deviceMemory/platform hooks


diff --git a/third_party/blink/renderer/core/frame/navigator_device_memory.cc b/third_party/blink/renderer/core/frame/navigator_device_memory.cc
index 05fa33e4568e8eea926a0d97c1d83a4000fa6b3f..49d481cf1dede4f9a616c3eb74965603ae0f8444 100644
--- a/third_party/blink/renderer/core/frame/navigator_device_memory.cc
+++ b/third_party/blink/renderer/core/frame/navigator_device_memory.cc
@@ -8,11 +8,14 @@
 #include "third_party/blink/public/mojom/use_counter/metrics/web_feature.mojom-shared.h"
 #include "third_party/blink/renderer/core/dom/document.h"
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/platform/fingerprint/fingerprint_config.h"
 
 namespace blink {
 
 float NavigatorDeviceMemory::deviceMemory() const {
-  return ApproximatedDeviceMemory::GetApproximatedDeviceMemory();
+  float value = ApproximatedDeviceMemory::GetApproximatedDeviceMemory();
+  return static_cast<float>(  // FP-HOOK
+      fp::Hook(fp::HookKey::kDeviceMemory, static_cast<double>(value)));
 }
 
 }  // namespace blink
diff --git a/third_party/blink/renderer/core/frame/navigator_id.cc b/third_party/blink/renderer/core/frame/navigator_id.cc
index 22243ebf5e26fc7224ef53694a1cd9dccf777196..cadf06dab18befcabe678937607798de214c4d7b 100644
--- a/third_party/blink/renderer/core/frame/navigator_id.cc
+++ b/third_party/blink/renderer/core/frame/navigator_id.cc
@@ -35,6 +35,7 @@
 #include "build/build_config.h"
 #include "third_party/blink/public/common/features.h"
 #include "third_party/blink/renderer/platform/wtf/text/string_builder.h"
+#include "third_party/blink/renderer/platform/fingerprint/fingerprint_config.h"
 
 #if !BUILDFLAG(IS_MAC) && !BUILDFLAG(IS_WIN)
 #include <sys/utsname.h>
@@ -63,8 +64,8 @@ String NavigatorID::platform() const {
   // Match Safari and Mozilla on Mac x86.
   return "MacIntel";
 #elif BUILDFLAG(IS_WIN)
-  // Match Safari and Mozilla on Windows.
-  return "Win32";
+  // Match Safari and Mozilla on Windows.（FP-HOOK：按分区 fp-config 覆盖）
+  return fp::Hook(fp::HookKey::kNavigatorPlatform, String("Win32"));
 #else  // Unix-like systems
   struct utsname osname;
   DEFINE_THREAD_SAFE_STATIC_LOCAL(ThreadSpecific<String>, platform_name, ());
