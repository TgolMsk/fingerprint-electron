Subject: fp_14: respect embedder --lang per-session


diff --git a/content/browser/renderer_host/render_process_host_impl.cc b/content/browser/renderer_host/render_process_host_impl.cc
index d4f038983987bf71cb44b25edc03a6cd1d72196c..844ace8926cf9908f587543d3e253c21e7385b25 100644
