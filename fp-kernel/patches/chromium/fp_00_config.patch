From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fp <fp@local>
Date: Sat, 26 Sep 2026 18:34:08 -0400
Subject: fp_00: FingerprintConfig reader + hardwareConcurrency hook

Adds third_party/blink/renderer/platform/fingerprint/ (process-wide
singleton reading --fp-config, deterministic noise, fp::Hook) and a
first hook in NavigatorConcurrentHardware::hardwareConcurrency.

diff --git a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
index f5c0db2d1b58de1fb54aa6545de8ac0fb177319e..87d108176e1edfca370cac89cdb440eb6cc4d9b1 100644
--- a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
+++ b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
@@ -5,11 +5,13 @@
 #include "third_party/blink/renderer/core/frame/navigator_concurrent_hardware.h"
 
 #include "base/system/sys_info.h"
+#include "third_party/blink/renderer/platform/fingerprint/fingerprint_config.h"
 
 namespace blink {
 
 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
-  return static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
+  unsigned value = static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
+  return fp::Hook(fp::HookKey::kHardwareConcurrency, value);  // FP-HOOK
 }
 
 }  // namespace blink
