     : DOMRectReadOnly(x, y, width, height) {}
 
+void DOMRect::ApplyFingerprintNoise() {
+  // Keep detached, hidden, zero-size and collapsed-range geometry intact.
+  // Apply after conversion to DOMRect: RectF would round away this perturbation
+  // for ordinary viewport coordinates such as 1000 CSS pixels.
+  if (width_ <= 0 || height_ <= 0)
+    return;
+  x_ = fp::JitterRect("x", x_);
+  y_ = fp::JitterRect("y", y_);
+  width_ = fp::JitterRect("w", width_);
+  height_ = fp::JitterRect("h", height_);
+}
