+// FP-HOOK begin
+void TextMetrics::ApplyJitter() {
+  if (text_.empty())
+    return;
+  width_ = fp::JitterRect("tw", width_);
+  actual_bounding_box_left_ = fp::JitterRect("tbl", actual_bounding_box_left_);
+  actual_bounding_box_right_ =
+      fp::JitterRect("tbr", actual_bounding_box_right_);
+  actual_bounding_box_ascent_ =
+      fp::JitterRect("tba", actual_bounding_box_ascent_);
+  actual_bounding_box_descent_ =
+      fp::JitterRect("tbd", actual_bounding_box_descent_);
+}
+// FP-HOOK end
+
 }  // namespace blink
