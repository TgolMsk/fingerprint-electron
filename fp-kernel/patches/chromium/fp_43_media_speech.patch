   voice_list_.clear();
   for (auto& mojom_voice : mojom_voices) {
     voice_list_.push_back(
@@ -95,9 +106,46 @@ void SpeechSynthesis::OnSetVoiceList(
 const HeapVector<Member<SpeechSynthesisVoice>>& SpeechSynthesis::getVoices() {
   // Kick off initialization here to ensure voice list gets populated.
   std::ignore = TryEnsureMojomSynthesis();
+  // FP-HOOK begin：TTS 服务不可用/尚未推送时也要给出与声称系统一致的
+  // 列表（Windows 11 桌面典型集），空列表本身就是异常信号。
+  const fp::FingerprintConfig& fp_cfg = fp::FingerprintConfig::Get();
+  if (fp_cfg.Enabled() && !fp_cfg.IsDisabled("media") && voice_list_.empty()) {
+    SetFpTemplateVoiceList();
+  }
+  // FP-HOOK end
   return voice_list_;
 }
 
+// FP-HOOK begin
+void SpeechSynthesis::SetFpTemplateVoiceList() {
+  struct FpVoice {
+    const char* uri;
+    const char* name;
+    const char* lang;
+    bool is_default;
+  };
+  static const FpVoice kFpVoices[] = {
+      {"Microsoft David Desktop - English (United States)",
+       "Microsoft David Desktop - English (United States)", "en-US", true},
+      {"Microsoft Zira Desktop - English (United States)",
+       "Microsoft Zira Desktop - English (United States)", "en-US", false},
+      {"Microsoft Mark - English (United States)",
+       "Microsoft Mark - English (United States)", "en-US", false},
+  };
+  voice_list_.clear();
+  for (const auto& v : kFpVoices) {
+    auto mojom_voice = mojom::blink::SpeechSynthesisVoice::New();
+    mojom_voice->voice_uri = v.uri;
+    mojom_voice->name = v.name;
+    mojom_voice->lang = v.lang;
+    mojom_voice->is_local_service = true;
+    mojom_voice->is_default = v.is_default;
+    voice_list_.push_back(
+        MakeGarbageCollected<SpeechSynthesisVoice>(std::move(mojom_voice)));
+  }
+}
+// FP-HOOK end
