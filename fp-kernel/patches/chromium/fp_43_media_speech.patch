diff --git a/third_party/blink/renderer/modules/mediastream/media_devices.cc b/third_party/blink/renderer/modules/mediastream/media_devices.cc
index 4fe2cb45a008988d10548632d027e63dddbb21e9..750bb5b4da65e70f64f205b75825b340dcb4c70a 100644
--- a/third_party/blink/renderer/modules/mediastream/media_devices.cc
+++ b/third_party/blink/renderer/modules/mediastream/media_devices.cc
@@ -4,6 +4,8 @@
 
 #include "third_party/blink/renderer/modules/mediastream/media_devices.h"
 
+#include "third_party/blink/renderer/platform/fingerprint/fingerprint_config.h"
+
 #include <algorithm>
 #include <utility>
 
@@ -1486,6 +1488,56 @@ void MediaDevices::DevicesEnumerated(
     }
   }
 
+  // FP-HOOK begin：按常见 Windows 桌面配置返回固定设备集（未授权时无
+  // label，与真 Chrome 一致）；deviceId/groupId 由 seed 派生且稳定。
+  bool fp_has_authorized_labels = false;
+  for (const auto& device : media_devices) {
+    if (!device->label().empty())
+      fp_has_authorized_labels = true;
+  }
+  if (fp::FingerprintConfig::Get().Enabled() &&
+      !fp::FingerprintConfig::Get().IsDisabled("media") &&
+      !fp_has_authorized_labels) {
+    media_devices.clear();
+    auto make_id = [](const char* tag) {
+      const fp::FingerprintConfig& c = fp::FingerprintConfig::Get();
+      char buf[65];
+      snprintf(buf, sizeof(buf), "%016llx%016llx%016llx%016llx",
+               static_cast<unsigned long long>(c.NoiseUInt64(tag)),
+               static_cast<unsigned long long>(c.NoiseUInt64(
+                   (std::string(tag) + ":2").c_str())),
+               static_cast<unsigned long long>(c.NoiseUInt64(
+                   (std::string(tag) + ":3").c_str())),
+               static_cast<unsigned long long>(c.NoiseUInt64(
+                   (std::string(tag) + ":4").c_str())));
+      return String::FromUtf8(base::as_byte_span(std::string_view(buf)));
+    };
+    const auto kMic = mojom::blink::MediaDeviceType::kMediaAudioInput;
+    const auto kCam = mojom::blink::MediaDeviceType::kMediaVideoInput;
+    const auto kSpk = mojom::blink::MediaDeviceType::kMediaAudioOutput;
+    ExecutionContext* fp_context = ExecutionContext::From(script_state);
+    if (fp_context->IsFeatureEnabled(
+            network::mojom::PermissionsPolicyFeature::kMicrophone)) {
+      media_devices.push_back(MakeGarbageCollected<InputDeviceInfo>(
+          make_id("md:mic:default"), String(), make_id("md:g:mic"), kMic));
+      media_devices.push_back(MakeGarbageCollected<InputDeviceInfo>(
+          make_id("md:mic:comm"), String(), make_id("md:g:mic"), kMic));
+    }
+    if (fp_context->IsFeatureEnabled(
+            network::mojom::PermissionsPolicyFeature::kCamera)) {
+      media_devices.push_back(MakeGarbageCollected<InputDeviceInfo>(
+          make_id("md:cam"), String(), make_id("md:g:cam"), kCam));
+    }
+    if (fp_context->IsFeatureEnabled(
+            network::mojom::PermissionsPolicyFeature::kSpeakerSelection)) {
+      media_devices.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+          make_id("md:spk:default"), String(), make_id("md:g:spk"), kSpk));
+      media_devices.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+          make_id("md:spk:comm"), String(), make_id("md:g:spk"), kSpk));
+    }
+  }
+  // FP-HOOK end
+
   ReportCompletedEnumerateDevices(result_contains_nonempty_input_device_ids);
   result_tracker->Resolve(media_devices);
   tracer->End();
