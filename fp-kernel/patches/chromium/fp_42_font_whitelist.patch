@@ -44,6 +44,7 @@
 #include "skia/ext/font_utils.h"
 #include "third_party/blink/public/platform/web_font_prewarmer.h"
 #include "third_party/blink/renderer/platform/fonts/bitmap_glyphs_block_list.h"
+#include "third_party/blink/renderer/platform/fingerprint/fingerprint_fonts.h"
 #include "third_party/blink/renderer/platform/fonts/font_cache.h"
 #include "third_party/blink/renderer/platform/fonts/font_description.h"
 #include "third_party/blink/renderer/platform/fonts/font_face_creation_params.h"
@@ -481,6 +482,22 @@ const FontPlatformData* FontCache::CreateFontPlatformData(
     }
   }
 
+  // FP-HOOK: Filter the resolved typeface, after native matching. This covers
+  // local() full/PostScript names and localized family aliases, while retaining
+  // native CSS generic-family and missing-family fallback behavior.
+  if (fp::FontsFilterEnabled()) {
+    SkString resolved_family;
+    typeface->getFamilyName(&resolved_family);
+    bool allowed = fp::FontAllowed(String::FromUtf8(resolved_family.c_str()));
+    SkTypeface::LocalizedStrings* families = typeface->createFamilyNameIterator();
+    SkTypeface::LocalizedString family;
+    while (!allowed && families->next(&family))
+      allowed = fp::FontAllowed(String::FromUtf8(family.fString.c_str()));
+    families->unref();
+    if (!allowed)
+      return nullptr;
+  }
+
   bool synthetic_bold_requested =
       (font_description.Weight() >= kBoldThreshold && !typeface->isBold()) ||
       font_description.IsSyntheticBold();
